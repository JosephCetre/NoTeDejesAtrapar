// Rng - NoTeDejesAtrapar
// Generador pseudoaleatorio congruencial lineal de 16 bits:
//   estado = estado * 25173 + 13849  (modulo 2^16: el desbordamiento de 16 bits es intencional)
// Se usan los bits ALTOS del estado, porque los bajos de un LCG tienen periodos cortos.
class Rng {
    static int state;

    function void seed(int s) {
        let state = (s * 31) + 7;
        return;
    }

    // Devuelve un entero en 0..(bound-1). bound debe ser > 0.
    function int next(int bound) {
        var int r;
        let state = (state * 25173) + 13849;
        let r = (state & 32767) / 64;          // 0..511 (bits 6..14)
        return r - ((r / bound) * bound);
    }
}
