// Obstacle - NoTeDejesAtrapar
// Obstaculos que se acercan por la derecha. Tipos:
//   0 chiva (se salta)   1 moto (se salta)   2 hueco (se salta)   3 gallinazo (se esquiva AGACHADO)
class Obstacle {
    field int x, y, w, h, kind;
    field boolean active;
    field int ox, oy, ow, oh;
    field boolean drawn;

    constructor Obstacle new() {
        let active = false;
        let drawn = false;
        let x = 0;
        return this;
    }

    method void reset() {            // solo tras redibujar toda la pantalla
        let active = false;
        let drawn = false;
        return;
    }

    method void kill() {             // desactiva; el sprite se borra solo en el proximo ciclo
        let active = false;
        return;
    }

    method void forget() {
        let drawn = false;
        return;
    }

    method boolean isActive() {
        return active;
    }

    method void spawn(int k) {
        let kind = k;
        let x = 512;
        let w = 30;
        let h = 22;
        let y = 194;
        if (k = 1) {
            let w = 18;
            let h = 14;
            let y = 202;
        }
        if (k = 2) {
            let w = 28;
            let h = 5;
            let y = 211;
        }
        if (k = 3) {
            let w = 20;
            let h = 12;
            let y = 196;
        }
        let active = true;
        return;
    }

    method void update(int speed) {
        if (active) {
            let x = x - speed;
            if ((x + w) < 0) {
                let active = false;
            }
        }
        return;
    }

    // Colision rectangular con la caja del jugador (derecha y abajo exclusivos).
    method boolean hits(int l, int t, int r, int b) {
        if (~active) { return false; }
        return ((x + 3) < r) & ((x + w - 3) > l) & ((y + 1) < b) & ((y + h) > t);
    }

    method void erase(boolean ink) {
        if (drawn) {
            do Screen.setColor(~ink);
            do Art.rect(ox, oy, ox + ow - 1, oy + oh - 1);
            let drawn = false;
        }
        return;
    }

    method void draw(boolean ink, int anim) {
        if (~active) { return; }
        let ox = x;
        let oy = y;
        let ow = w;
        let oh = h;
        let drawn = true;
        do Screen.setColor(ink);
        if (kind = 0) {
            // chiva
            do Art.r(ox, oy, 4, 0, 10, 2);       // bultos
            do Art.r(ox, oy, 14, 1, 22, 2);
            do Art.r(ox, oy, 1, 3, 28, 4);       // parrilla del techo
            do Art.r(ox, oy, 0, 5, 29, 17);      // carroceria
            do Art.r(ox, oy, 3, 16, 9, 21);      // llantas
            do Art.r(ox, oy, 21, 16, 27, 21);
            do Screen.setColor(~ink);
            do Art.r(ox, oy, 3, 7, 8, 11);       // ventanas
            do Art.r(ox, oy, 11, 7, 16, 11);
            do Art.r(ox, oy, 19, 7, 24, 11);
            do Art.r(ox, oy, 0, 13, 29, 13);     // franja de colores
            do Art.r(ox, oy, 5, 18, 7, 19);      // rines
            do Art.r(ox, oy, 23, 18, 25, 19);
        }
        if (kind = 1) {
            // moto
            do Art.r(ox, oy, 0, 8, 5, 13);       // llantas
            do Art.r(ox, oy, 12, 8, 17, 13);
            do Art.r(ox, oy, 4, 5, 13, 9);       // cuerpo
            do Art.r(ox, oy, 4, 3, 8, 4);        // asiento
            do Art.r(ox, oy, 12, 2, 16, 3);      // manubrio
            do Art.r(ox, oy, 13, 3, 14, 6);      // horquilla
            do Screen.setColor(~ink);
            do Art.r(ox, oy, 2, 10, 3, 11);      // rines
            do Art.r(ox, oy, 14, 10, 15, 11);
        }
        if (kind = 2) {
            // hueco en la via
            do Art.r(ox, oy, 2, 0, 25, 0);
            do Art.r(ox, oy, 0, 1, 27, 4);
        }
        if (kind = 3) {
            // gallinazo con aleteo
            do Art.r(ox, oy, 5, 4, 14, 7);       // cuerpo
            do Art.r(ox, oy, 15, 3, 18, 6);      // cabeza
            do Art.r(ox, oy, 19, 5, 19, 5);      // pico
            do Art.r(ox, oy, 1, 5, 4, 6);        // cola
            if (anim = 0) {
                do Art.r(ox, oy, 6, 0, 9, 3);    // alas arriba
                do Art.r(ox, oy, 10, 1, 13, 3);
            }
            else {
                do Art.r(ox, oy, 6, 8, 9, 11);   // alas abajo
                do Art.r(ox, oy, 10, 8, 13, 10);
            }
            do Screen.setColor(~ink);
            do Art.r(ox, oy, 17, 4, 17, 4);      // ojo
        }
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
