// HUD - NoTeDejesAtrapar
// Marcador en la franja blanca superior (y 0..11): puntos, vidas (corazones), barra de distancia,
// poder activo y nivel. Solo redibuja lo que cambia. Siempre negro sobre blanco.
class HUD {
    field int oScore, oLives, oGap, oPower, oLevel;

    // Imprime una cadena y LA LIBERA (las cadenas literales de Jack se crean en cada ejecucion).
    function void text(String s) {
        do Output.printString(s);
        do s.dispose();
        return;
    }

    constructor HUD new() {
        let oScore = -1;
        let oLives = -1;
        let oGap = -1;
        let oPower = -1;
        let oLevel = -1;
        return this;
    }

    // Dibuja las etiquetas fijas y obliga a repintar todos los valores.
    method void reset() {
        do Output.moveCursor(0, 0);
        do HUD.text("PUNTOS:");
        do Output.moveCursor(0, 15);
        do HUD.text("VIDAS:");
        do Output.moveCursor(0, 27);
        do HUD.text("DIST:");
        do Output.moveCursor(0, 46);
        do HUD.text("PODER:");
        do Output.moveCursor(0, 58);
        do HUD.text("NIV:");
        let oScore = -1;
        let oLives = -1;
        let oGap = -1;
        let oPower = -1;
        let oLevel = -1;
        return;
    }

    method void draw(int score, int lives, int gap, int power, int level) {
        var int i;
        if (~(score = oScore)) {
            do Output.moveCursor(0, 8);
            do Output.printInt(score);
            do HUD.text("    ");
            let oScore = score;
        }
        if (~(lives = oLives)) {
            let i = 0;
            while (i < 3) {
                do HUD.heart(170 + (i * 12), i < lives);
                let i = i + 1;
            }
            let oLives = lives;
        }
        if (~(gap = oGap)) {
            do HUD.bar(gap);
            let oGap = gap;
        }
        if (~(power = oPower)) {
            do Output.moveCursor(0, 52);
            if (power = 0) { do HUD.text("---  "); }
            if (power = 1) { do HUD.text("CAFE "); }
            if (power = 2) { do HUD.text("AREPA"); }
            let oPower = power;
        }
        if (~(level = oLevel)) {
            do Output.moveCursor(0, 62);
            do Output.printInt(level + 1);
            let oLevel = level;
        }
        return;
    }

    // Corazon de 7 x 6 px; on=true lo dibuja negro, on=false lo borra (la franja es blanca).
    function void heart(int x, boolean on) {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, 2, x + 7, 8);
        do Screen.setColor(true);
        if (on) {
            do Screen.drawRectangle(x + 1, 2, x + 2, 2);
            do Screen.drawRectangle(x + 4, 2, x + 5, 2);
            do Screen.drawRectangle(x, 3, x + 6, 4);
            do Screen.drawRectangle(x + 1, 5, x + 5, 5);
            do Screen.drawRectangle(x + 2, 6, x + 4, 6);
            do Screen.drawRectangle(x + 3, 7, x + 3, 7);
        }
        else {
            do Screen.drawRectangle(x, 3, x + 6, 3);
            do Screen.drawRectangle(x, 3, x, 5);
            do Screen.drawRectangle(x + 6, 3, x + 6, 5);
            do Screen.drawRectangle(x + 1, 6, x + 5, 6);
        }
        return;
    }

    // Barra de distancia al presidente: llena = a salvo (100), vacia = te atrapa.
    function void bar(int gap) {
        do Screen.setColor(true);
        do Screen.drawRectangle(262, 1, 363, 9);
        do Screen.setColor(false);
        do Screen.drawRectangle(263, 2, 362, 8);
        if (gap > 0) {
            do Screen.setColor(true);
            do Screen.drawRectangle(263, 2, 262 + gap, 8);
        }
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
