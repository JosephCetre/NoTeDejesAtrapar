// PowerUp - NoTeDejesAtrapar
// Poderes que flotan a la altura del salto (hay que saltar para recogerlos):
//   0 cafe  = turbo (mas velocidad) y recupera distancia
//   1 arepa = salto mas alto
class PowerUp {
    field int x, y, kind;
    field boolean active;
    field int ox, oy;
    field boolean drawn;

    constructor PowerUp new() {
        let active = false;
        let drawn = false;
        let x = 0;
        let y = 160;
        let kind = 0;
        return this;
    }

    method void reset() {            // solo tras redibujar toda la pantalla
        let active = false;
        let drawn = false;
        return;
    }

    method void kill() {
        let active = false;
        return;
    }

    method void forget() {
        let drawn = false;
        return;
    }

    method boolean isActive() {
        return active;
    }

    method int getKind() {
        return kind;
    }

    method void spawn(int k) {
        let kind = k;
        let x = 512;
        let y = 160;
        let active = true;
        return;
    }

    method void update(int speed) {
        if (active) {
            let x = x - speed;
            if ((x + 12) < 0) {
                let active = false;
            }
        }
        return;
    }

    method boolean hits(int l, int t, int r, int b) {
        if (~active) { return false; }
        return (x < r) & ((x + 12) > l) & (y < b) & ((y + 12) > t);
    }

    method void erase(boolean ink) {
        if (drawn) {
            do Screen.setColor(~ink);
            do Art.rect(ox, oy, ox + 11, oy + 11);
            let drawn = false;
        }
        return;
    }

    method void draw(boolean ink) {
        if (~active) { return; }
        let ox = x;
        let oy = y;
        let drawn = true;
        do Screen.setColor(ink);
        if (kind = 0) {
            // taza de cafe con vapor
            do Art.r(ox, oy, 1, 4, 8, 10);       // taza
            do Art.r(ox, oy, 9, 5, 11, 8);       // asa
            do Art.r(ox, oy, 0, 11, 9, 11);      // plato
            do Art.r(ox, oy, 3, 0, 3, 2);        // vapor
            do Art.r(ox, oy, 6, 1, 6, 3);
            do Screen.setColor(~ink);
            do Art.r(ox, oy, 2, 5, 7, 5);        // cafe
            do Art.r(ox, oy, 9, 6, 10, 7);       // hueco del asa
        }
        else {
            // arepa
            do Art.r(ox, oy, 4, 0, 7, 0);
            do Art.r(ox, oy, 2, 1, 9, 1);
            do Art.r(ox, oy, 1, 2, 10, 9);
            do Art.r(ox, oy, 2, 10, 9, 10);
            do Art.r(ox, oy, 4, 11, 7, 11);
            do Screen.setColor(~ink);
            do Art.r(ox, oy, 3, 3, 3, 3);
            do Art.r(ox, oy, 7, 3, 7, 3);
            do Art.r(ox, oy, 5, 6, 5, 6);
            do Art.r(ox, oy, 3, 8, 3, 8);
            do Art.r(ox, oy, 8, 8, 8, 8);
        }
        return;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
