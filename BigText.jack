// BigText - NoTeDejesAtrapar
// Fuente propia de mapas de bits de 5 x 7, escalable, para letreros grandes.
// Output.printString solo escribe letras pequenas; aqui cada punto encendido se dibuja
// como un cuadrado de (escala x escala) con Screen.drawRectangle.
// Letras disponibles: A B C D E G I J L M N O P R S T V (y espacio).
class BigText {
    static Array font;        // 17 letras x 7 filas (cada fila = 5 bits)
    static String letters;

    function void init() {
        let font = Array.new(119);
        let letters = "ABCDEGIJLMNOPRSTV";
        do BigText.def(0, 14, 17, 17, 31, 17, 17, 17);    // A
        do BigText.def(1, 30, 17, 17, 30, 17, 17, 30);    // B
        do BigText.def(2, 14, 17, 16, 16, 16, 17, 14);    // C
        do BigText.def(3, 30, 17, 17, 17, 17, 17, 30);    // D
        do BigText.def(4, 31, 16, 16, 30, 16, 16, 31);    // E
        do BigText.def(5, 14, 17, 16, 23, 17, 17, 15);    // G
        do BigText.def(6, 14, 4, 4, 4, 4, 4, 14);         // I
        do BigText.def(7, 7, 2, 2, 2, 2, 18, 12);         // J
        do BigText.def(8, 16, 16, 16, 16, 16, 16, 31);    // L
        do BigText.def(9, 17, 27, 21, 21, 17, 17, 17);    // M
        do BigText.def(10, 17, 25, 21, 19, 17, 17, 17);   // N
        do BigText.def(11, 14, 17, 17, 17, 17, 17, 14);   // O
        do BigText.def(12, 30, 17, 17, 30, 16, 16, 16);   // P
        do BigText.def(13, 30, 17, 17, 30, 20, 18, 17);   // R
        do BigText.def(14, 15, 16, 16, 14, 1, 1, 30);     // S
        do BigText.def(15, 31, 4, 4, 4, 4, 4, 4);         // T
        do BigText.def(16, 17, 17, 17, 17, 17, 10, 4);    // V
        return;
    }

    function void def(int g, int r0, int r1, int r2, int r3, int r4, int r5, int r6) {
        var int b;
        let b = g * 7;
        let font[b] = r0;
        let font[b + 1] = r1;
        let font[b + 2] = r2;
        let font[b + 3] = r3;
        let font[b + 4] = r4;
        let font[b + 5] = r5;
        let font[b + 6] = r6;
        return;
    }

    // Indice de la letra en la fuente, o -1 (espacio / no soportada).
    function int index(int c) {
        var int i;
        let i = 0;
        while (i < letters.length()) {
            if (letters.charAt(i) = c) { return i; }
            let i = i + 1;
        }
        return -1;
    }

    function void glyph(int g, int x, int y, int s) {
        var int r, c, mask, bits;
        let r = 0;
        while (r < 7) {
            let bits = font[(g * 7) + r];
            let mask = 16;
            let c = 0;
            while (c < 5) {
                if (~((bits & mask) = 0)) {
                    do Screen.drawRectangle(x + (c * s), y + (r * s), x + (c * s) + s - 1, y + (r * s) + s - 1);
                }
                let mask = mask / 2;
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    // Ancho en pixeles de un texto de n letras a escala s.
    function int width(int n, int s) {
        return (n * 6 * s) - s;
    }

    // Dibuja el texto con el color actual. CONSUME (libera) la cadena recibida.
    function void drawText(String t, int x, int y, int s) {
        var int i, g;
        let i = 0;
        while (i < t.length()) {
            let g = BigText.index(t.charAt(i));
            if (g > -1) {
                do BigText.glyph(g, x, y, s);
            }
            let x = x + (6 * s);
            let i = i + 1;
        }
        do t.dispose();
        return;
    }
}
